# ==============================================================================
# WAANOFII ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and configure local/production values. NEVER commit .env to git.
# ==============================================================================

# Application & Runtime
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
TENANT_BASE_DOMAIN=waanofii.local

# Database Connection (PostgreSQL 17+)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/waanofii_db?schema=public"

# Authentication & Security Secrets
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
COOKIE_SECRET=your_cookie_signing_secret_key_change_in_production

# CORS & Network Security
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:5173

# Rate Limiting (Throttler)
THROTTLE_TTL=60000
THROTTLE_LIMIT=60
AUTH_THROTTLE_LIMIT=10
